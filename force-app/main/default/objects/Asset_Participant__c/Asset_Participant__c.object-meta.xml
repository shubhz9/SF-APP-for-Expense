<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Participant / co-owner for a shared asset.</description>
    <enableActivities>false</enableActivities>
    <enableHistory>false</enableHistory>
    <label>Asset Participant</label>
    <pluralLabel>Asset Participants</pluralLabel>
    <nameField>
        <label>Asset Participant Name</label>
        <type>Text</type>
    </nameField>
    <sharingModel>Private</sharingModel>

    <!-- Parent Asset -->
    <fields>
        <fullName>Shared_Asset__c</fullName>
        <description>Shared asset that this participant belongs to.</description>
        <externalId>false</externalId>
        <label>Shared Asset</label>
        <referenceTo>Shared_Asset__c</referenceTo>
        <relationshipLabel>Asset Participants</relationshipLabel>
        <relationshipName>Asset_Participants</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>

    <!-- Participant can be a User -->
    <fields>
        <fullName>User__c</fullName>
        <description>Salesforce User as participant.</description>
        <externalId>false</externalId>
        <label>User</label>
        <referenceTo>User</referenceTo>
        <relationshipLabel>User Asset Participants</relationshipLabel>
        <relationshipName>User_Asset_Participants</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>

    <!-- Or a Contact -->
    <fields>
        <fullName>Contact__c</fullName>
        <description>Contact as participant.</description>
        <externalId>false</externalId>
        <label>Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Contact Asset Participants</relationshipLabel>
        <relationshipName>Contact_Asset_Participants</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>

    <fields>
        <fullName>Ownership_Percentage__c</fullName>
        <description>Ownership percentage of the asset.</description>
        <externalId>false</externalId>
        <label>Ownership Percentage</label>
        <precision>5</precision>
        <scale>2</scale>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>

    <fields>
        <fullName>Loan_Share_Percentage__c</fullName>
        <description>Share percentage for loan repayments.</description>
        <externalId>false</externalId>
        <label>Loan Share Percentage</label>
        <precision>5</precision>
        <scale>2</scale>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>

    <fields>
        <fullName>Total_Equity_Contributed__c</fullName>
        <description>Total equity contributed by this participant.</description>
        <externalId>false</externalId>
        <label>Total Equity Contributed</label>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>

    <fields>
        <fullName>Total_Loan_Paid__c</fullName>
        <description>Total loan amount paid by this participant.</description>
        <externalId>false</externalId>
        <label>Total Loan Paid</label>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>

    <fields>
        <fullName>Total_Income_Share__c</fullName>
        <description>Total income share attributed to this participant.</description>
        <externalId>false</externalId>
        <label>Total Income Share</label>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>

    <fields>
        <fullName>Total_Expense_Share__c</fullName>
        <description>Total expense share attributed to this participant.</description>
        <externalId>false</externalId>
        <label>Total Expense Share</label>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>

    <fields>
        <fullName>Net_Position__c</fullName>
        <description>Net position of the participant for this asset.</description>
        <externalId>false</externalId>
        <label>Net Position</label>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>

    <fields>
        <fullName>Is_Active__c</fullName>
        <description>Is this participant currently active for the asset?</description>
        <externalId>false</externalId>
        <label>Is Active</label>
        <defaultValue>true</defaultValue>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>

</CustomObject>