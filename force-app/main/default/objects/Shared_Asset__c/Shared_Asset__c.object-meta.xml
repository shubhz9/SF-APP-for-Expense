<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Co-owned asset such as car, flat, etc.</description>
    <enableActivities>true</enableActivities>
    <enableHistory>false</enableHistory>
    <label>Shared Asset</label>
    <pluralLabel>Shared Assets</pluralLabel>
    <nameField>
        <label>Shared Asset Name</label>
        <type>Text</type>
    </nameField>
    <sharingModel>Private</sharingModel>

    <!-- Base Currency (optional, if not using SF multi-currency logic directly) -->
    <fields>
        <fullName>Base_Currency__c</fullName>
        <description>Base currency code for this asset (e.g. INR, USD).</description>
        <externalId>false</externalId>
        <label>Base Currency</label>
        <length>10</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>

    <fields>
        <fullName>Total_Cost__c</fullName>
        <description>Total purchase cost of the asset.</description>
        <externalId>false</externalId>
        <label>Total Cost</label>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>

    <fields>
        <fullName>Purchase_Date__c</fullName>
        <description>Purchase date of the asset.</description>
        <externalId>false</externalId>
        <label>Purchase Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>

    <fields>
        <fullName>Total_Equity_Contributed__c</fullName>
        <description>Total equity contributed across all participants.</description>
        <externalId>false</externalId>
        <label>Total Equity Contributed</label>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>

    <fields>
        <fullName>Total_Loan_Taken__c</fullName>
        <description>Total loan amount taken for this asset.</description>
        <externalId>false</externalId>
        <label>Total Loan Taken</label>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>

    <fields>
        <fullName>Outstanding_Loan__c</fullName>
        <description>Outstanding loan amount for this asset.</description>
        <externalId>false</externalId>
        <label>Outstanding Loan</label>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>

    <fields>
        <fullName>Total_Income__c</fullName>
        <description>Total income generated by this asset.</description>
        <externalId>false</externalId>
        <label>Total Income</label>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>

    <fields>
        <fullName>Total_Expenses__c</fullName>
        <description>Total expenses incurred for this asset.</description>
        <externalId>false</externalId>
        <label>Total Expenses</label>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>

    <fields>
        <fullName>Net_Cashflow__c</fullName>
        <description>Net cashflow for this asset.</description>
        <externalId>false</externalId>
        <label>Net Cashflow</label>
        <precision>16</precision>
        <scale>2</scale>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>

    <fields>
        <fullName>Status__c</fullName>
        <description>Status of the shared asset.</description>
        <externalId>false</externalId>
        <label>Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Planned</fullName>
                    <default>true</default>
                    <label>Planned</label>
                </value>
                <value>
                    <fullName>Active</fullName>
                    <default>false</default>
                    <label>Active</label>
                </value>
                <value>
                    <fullName>Sold</fullName>
                    <default>false</default>
                    <label>Sold</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>

</CustomObject>