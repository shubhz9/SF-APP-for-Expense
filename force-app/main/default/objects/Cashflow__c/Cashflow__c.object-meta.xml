        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Contribution</fullName>
                    <default>false</default>
                    <label>Contribution</label>
                </value>
                <value>
                    <fullName>Loan_Repayment</fullName>
                    <default>false</default>
                    <label>Loan Repayment</label>
                </value>
                <value>
                    <fullName>Income</fullName>
                    <default>false</default>
                    <label>Income</label>
                </value>
                <value>
                    <fullName>Expense</fullName>
                    <default>false</default>
                    <label>Expense</label>
                </value>
                <value>
                    <fullName>Sale_Proceeds</fullName>
                    <default>false</default>
                    <label>Sale Proceeds</label>
                </value>
                <value>
                    <fullName>Adjustment</fullName>
                    <default>true</default>
                    <label>Adjustment</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>

    <fields>
        <fullName>Amount__c</fullName>
        <description>Amount of this cashflow.</description>
        <externalId>false</externalId>
        <label>Amount</label>
        <precision>16</precision>
