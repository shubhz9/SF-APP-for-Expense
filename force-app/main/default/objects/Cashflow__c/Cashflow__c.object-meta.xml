        <referenceTo>Shared_Asset__c</referenceTo>
        <relationshipLabel>Cashflows</relationshipLabel>
        <relationshipName>Cashflows</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>

    <fields>
        <fullName>Loan__c</fullName>
